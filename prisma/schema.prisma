// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CircleRole {
  OWNER
  ADMIN
  MEMBER
}

enum CircleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContributionFrequency {
  WEEKLY
  MONTHLY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
}

enum ContributionCycleStatus {
  UPCOMING
  OPEN
  COMPLETED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  PAID
  LATE
  MISSED
  WAIVED
}

enum PayoutStatus {
  PENDING
  READY
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCircles      SavingsCircle[] @relation("CircleOwner")
  circleMemberships CircleMember[]
}

model SavingsCircle {
  id                 String                @id @default(cuid())
  name               String
  description        String?
  contributionAmount Decimal               @db.Decimal(10, 2)
  frequency          ContributionFrequency
  startDate          DateTime
  maxMembers         Int                   @default(10)
  status             CircleStatus          @default(DRAFT)
  inviteCode         String                @unique
  ownerId            String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  owner   User                @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CircleMember[]
  cycles  ContributionCycle[]

  @@index([ownerId])
}

model CircleMember {
  id              String           @id @default(cuid())
  userId          String
  savingsCircleId String
  role            CircleRole       @default(MEMBER)
  status          MembershipStatus @default(ACTIVE)
  payoutPosition  Int?
  joinedAt        DateTime         @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsCircle SavingsCircle       @relation(fields: [savingsCircleId], references: [id], onDelete: Cascade)
  payoutCycles  ContributionCycle[] @relation("CyclePayoutRecipient")
  contributions Contribution[]

  @@unique([userId, savingsCircleId])
  @@index([savingsCircleId])
}

model ContributionCycle {
  id                String                  @id @default(cuid())
  savingsCircleId   String
  cycleNumber       Int
  scheduledDate     DateTime
  expectedAmount    Decimal                 @db.Decimal(10, 2)
  payoutRecipientId String
  status            ContributionCycleStatus @default(UPCOMING)
  payoutStatus      PayoutStatus            @default(PENDING)
  payoutReference   String?
  payoutNotes       String?
  payoutCompletedBy String?
  payoutCompletedAt DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  savingsCircle   SavingsCircle  @relation(fields: [savingsCircleId], references: [id], onDelete: Cascade)
  payoutRecipient CircleMember   @relation("CyclePayoutRecipient", fields: [payoutRecipientId], references: [id], onDelete: Restrict)
  contributions   Contribution[]

  @@unique([savingsCircleId, cycleNumber])
  @@unique([savingsCircleId, payoutRecipientId])
  @@index([savingsCircleId])
  @@index([payoutRecipientId])
  @@index([scheduledDate])
}

model Contribution {
  id         String             @id @default(cuid())
  cycleId    String
  memberId   String
  amountDue  Decimal            @db.Decimal(10, 2)
  amountPaid Decimal            @default(0) @db.Decimal(10, 2)
  status     ContributionStatus @default(PENDING)
  paidAt     DateTime?
  reference  String?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  cycle  ContributionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member CircleMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([cycleId, memberId])
  @@index([memberId])
  @@index([status])
}
